{
  "name": "myartist-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "myartist.in API: SQLite + Fastify",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "create-admin": "node --env-file-if-exists=.env scripts/create-admin.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.2.2",
    "better-sqlite3": "^13.2.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  }
}
