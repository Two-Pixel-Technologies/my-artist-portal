# Copy to .env. Loaded automatically by `npm run dev` / `npm start`.
PORT=4000
HOST=127.0.0.1
# Where the SQLite file and photos live. Back this directory up (see README).
DATA_DIR=./data
# Public URL of the website: used to build review links
SITE_URL=http://localhost:3000
# Default WhatsApp number (country code, digits only). Admins can change it in Settings.
WHATSAPP_NUMBER=919712026900
# Production: set to 1 behind a reverse proxy so rate limits see real client IPs
TRUST_PROXY=0
# Production: any long random string. The server refuses to start in production without it.
IP_SALT=
# Optional Cloudflare Turnstile for the enquiry form
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
